{
  "manifest_version": 3,
  "name": "搜索助手 (摸鱼防老板工具)",
  "version": "2.0",
  "description": "怎么样才能上班摸鱼？怎么样才能防止老板发现你上班摸鱼？",
  "icons": {
    "128": "assets/icon.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "assets/icon.png",
    "default_title": "准备开始摸鱼了吗？",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/fake-url.js", "js/content-script.js"],
      "css": ["css/content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["fake/*", "fake/assets/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "homepage_url": "https://github.com/peal-L/prevent-boss-for-browser"
}
